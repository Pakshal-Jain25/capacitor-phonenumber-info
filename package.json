{
  "name": "capacitor-sim-pro",
  "version": "0.0.3-beta",
  "description": "Capacitor plugin to get user phonenumber information from device's sim cards",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "sim",
    "phonenumber"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pakshal-Jain25/capacitor-phonenumber-info.git"
  },
  "license": "0BSD",
  "author": "pakshal-24 <pakshal@mobicloud.co.in>",
  "main": "dist/plugin.cjs.js",
  "unpkg": "dist/plugin.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "CapacitorSim.podspec"
  ],
  "scripts": {
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "docgen": "docgen --api SimPlugin --output-readme README.md --output-json dist/docs.json",
    "eslint": "eslint . --ext ts",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "prepublishOnly": "npm run build",
    "prettier": "prettier .",
    "release": "commit-and-tag-version",
    "swiftlint": "node-swiftlint",
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "verify:web": "npm run build",
    "watch": "tsc --watch"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
